import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("================================");
        System.out.println("    SCIENTIFIC CALCULATOR");
        System.out.println("================================");

        System.out.print("Enter first number: ");
        double a = sc.nextDouble();

        System.out.print("Enter second number: ");
        double b = sc.nextDouble();

        System.out.println("\n===== CALCULATION RESULTS =====");

        // Arithmetic operations
        System.out.println("Addition: " + (a + b));
        System.out.println("Subtraction: " + (a - b));
        System.out.println("Multiplication: " + (a * b));

        if (b != 0) {
            System.out.println("Division: " + (a / b));
        } else {
            System.out.println("Division: Cannot divide by zero");
        }

        // Square root
        if (a >= 0) {
            System.out.println("Square Root of first number: "
                    + Math.sqrt(a));
        } else {
            System.out.println("Square Root: Invalid for negative number");
        }

        // Power
        System.out.println("Power (first ^ second): " + Math.pow(a, b));

        // Trigonometric operations (angle in degrees)
        System.out.println("Sine of first number: "
                + Math.sin(Math.toRadians(a)));

        System.out.println("Cosine of first number: "
                + Math.cos(Math.toRadians(a)));

        if (Math.abs(Math.cos(Math.toRadians(a))) < 1e-10) {
            System.out.println("Tangent of first number: Undefined");
        } else {
            System.out.println("Tangent of first number: "
                    + Math.tan(Math.toRadians(a)));
        }

        // Logarithm
        if (a > 0) {
            System.out.println("Logarithm (base 10) of first number: "
                    + Math.log10(a));
        } else {
            System.out.println("Logarithm: Requires a positive number");
        }

        System.out.println("================================");
        System.out.println("       CALCULATIONS DONE!");
        System.out.println("================================");

        sc.close();
    }
}
